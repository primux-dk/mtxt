{
  "name": "@mtxt/web",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "build:e2e": "MTXT_E2E_BUILD=1 opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev --local --var MTXT_LOCAL_DEV:1 --port 8787",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed-local.mjs",
    "import-locales": "node scripts/import-design-locales.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:no-fakes": "node scripts/check-no-fakes.mjs",
    "check:d1-upgrade": "node scripts/d1-upgrade-check.mjs --from 0001_login_settings.sql",
    "stt:compare": "tsx scripts/stt-compare.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@mtxt/adapters": "workspace:*",
    "@mtxt/contract": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-drag-handle": "3.32.0",
    "@tiptap/extension-drag-handle-react": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-node-range": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "docx": "^9.13.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "markdown-it": "^14.3.3",
    "next": "^15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "prosemirror-markdown": "^1.13.8",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jszip": "^3.10.2",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "yaml": "^2.9.1"
  }
}
