# The e2e run's Worker secrets: placeholders, never a real tenant or credential.
# Passed to `wrangler dev --env-file` by playwright.config.ts.
AUTH_SECRET=e2e-auth-secret-not-a-real-secret-0123456789
SETTINGS_KEY=ZTJlLXNldHRpbmdzLWtleS1ub3QtYS1zZWNyZXQtMDE=
OIDC_PROVIDER=entra
OIDC_TENANT_ID=00000000-0000-4000-8000-000000000001
OIDC_CLIENT_ID=00000000-0000-4000-8000-000000000002
OIDC_CLIENT_SECRET=e2e-client-secret-not-a-credential
AUTH_TEST_MODE=1
# The install's origin and the fakes; playwright.config.ts sets them again for its port with --var.
PUBLIC_URL=http://localhost:8788
# The fake providers, served by the e2e build only (lib/stt/test-hooks.ts).
ASSEMBLYAI_BASE_URL=http://localhost:8788/api/test/fake-assemblyai
WORKERS_AI_FAKE_URL=http://localhost:8788/api/test/fake-workers-ai
RECAP_FAKE_URL=http://localhost:8788/api/test/fake-recap
