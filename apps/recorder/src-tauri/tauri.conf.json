{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mtxt Recorder",
  "version": "0.2.0",
  "identifier": "co.mtxt.recorder",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Primux (PRIMUX DIGITAL, S.L.). PolyForm Noncommercial 1.0.0.",
    "shortDescription": "Meeting recorder",
    "longDescription": "Records the microphone and the system audio of a meeting and uploads it to the company's own library.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../../docs/design/fonts/LICENSE-mona-sans.txt": "licenses/LICENSE-mona-sans.txt",
      "../../../NOTICE.md": "licenses/NOTICE.md",
      "../../../LICENSE.md": "licenses/LICENSE.md",
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "locales/da.lproj/InfoPlist.strings": "da.lproj/InfoPlist.strings"
    },
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        }
      }
    }
  }
}
